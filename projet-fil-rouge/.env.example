# =============================================================================
# ShopArch — Variables d'environnement
# =============================================================================
# Copiez ce fichier en .env et adaptez les valeurs si nécessaire :
#   cp .env.example .env
# =============================================================================

# Base de données
DATABASE_URL=postgresql://shoparch:shoparch@localhost:5432/shoparch

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3 local)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=shoparch-media

# Auth (sera configuré au Module 03)
# OIDC_ISSUER=http://localhost:8080/realms/shoparch

# Front-end
NEXT_PUBLIC_API_URL=http://localhost:3001/api
