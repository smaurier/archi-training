{
  "name": "architecture-labs",
  "version": "1.0.0",
  "private": true,
  "description": "Oracles exécutables des labs Architecture (règle : un lab = un geste métier complet). Frontières prouvées par les tests (relecture du code source des imports), pas juste par la doc.",
  "type": "module",
  "scripts": {
    "lab:01": "vitest run --root lab-01-clean-hexagonal-de-zero",
    "solution:01": "vitest run --root lab-01-clean-hexagonal-de-zero --config vitest.solution.config.ts",
    "lab:02": "vitest run --root lab-02-ddd-un-domaine-de-zero",
    "solution:02": "vitest run --root lab-02-ddd-un-domaine-de-zero --config vitest.solution.config.ts",
    "lab:03": "vitest run --root lab-03-extraire-un-domaine",
    "solution:03": "vitest run --root lab-03-extraire-un-domaine --config vitest.solution.config.ts",
    "lab:04": "vitest run --root lab-04-relire-une-architecture",
    "solution:04": "vitest run --root lab-04-relire-une-architecture --config vitest.solution.config.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  }
}
